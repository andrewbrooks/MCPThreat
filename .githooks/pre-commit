#!/usr/bin/env bash
# Pre-commit checks: keep secrets and lint errors out of history.
# Enable with:  git config core.hooksPath .githooks   (npm run setup does this for you)
# Skip once, if you must:  git commit --no-verify   (CI still runs the same checks)
set -euo pipefail

# Staged files that were added, copied or modified (portable: no bash 4 features).
staged=()
while IFS= read -r f; do
  [ -n "$f" ] && staged+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM)
[ "${#staged[@]}" -eq 0 ] && exit 0

# 1. Never commit environment files. .env.example is the documented template and is fine.
for f in "${staged[@]}"; do
  case "$f" in
    .env.example | */.env.example) ;;
    .env | .env.* | */.env | */.env.*)
      echo "pre-commit: refusing to commit '$f'. Environment files hold secrets." >&2
      exit 1
      ;;
  esac
done

# 2. Never add working files (mockups, scratch output, backups) to the repo. Only newly added
#    files are checked, so files already tracked are never affected.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    scratch/* | designs/* | mockups/* | *.bak | *.orig | *.artifact.html | *mockup* | *hybrid*)
      reason="looks like a working file" ;;
    docs/* | src/*) continue ;;
    *.html)
      reason="HTML outside docs/ and src/ is usually a generated page" ;;
    *) continue ;;
  esac
  echo "pre-commit: refusing to add '$f' ($reason)." >&2
  echo "            Keep working files outside the repo. If it is intentional: git commit --no-verify" >&2
  exit 1
done < <(git diff --cached --name-only --diff-filter=A)

# 3. Scan what is staged for secrets.
if command -v gitleaks > /dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner
else
  echo "pre-commit: gitleaks is not installed, so the secret scan was skipped (CI still scans)." >&2
  echo "            Install it from https://github.com/gitleaks/gitleaks#installing" >&2
fi

# 4. Check formatting of staged files. Files Prettier ignores (see .prettierignore) are skipped.
#    Fix with: npm run format
npx --no-install prettier --check --ignore-unknown --no-error-on-unmatched-pattern "${staged[@]}"

# 5. Lint staged TypeScript, with the same rules as CI.
source_files=()
for f in "${staged[@]}"; do
  case "$f" in
    *.ts | *.tsx | *.mjs) source_files+=("$f") ;;
  esac
done
if [ "${#source_files[@]}" -gt 0 ]; then
  npx --no-install eslint --max-warnings 0 "${source_files[@]}"
fi
